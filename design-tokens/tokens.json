{
  "name": "MediAI Care Design Tokens",
  "version": "1.0.0",
  "description": "Single source of truth for MediAI Care colors, type, spacing, radii, elevation and motion. Consumed by src/theme/tokens.ts.",
  "color": {
    "primary": {
      "blue": "#1565C0",
      "blueDeep": "#1E5BB8",
      "blueSoft": "#DCEEFB",
      "onPrimary": "#FFFFFF"
    },
    "secondary": {
      "teal": "#2ECC71",
      "tealSoft": "#D6F5E3",
      "onSecondary": "#FFFFFF"
    },
    "aiDark": {
      "navy": "#0D1B2A",
      "navyElevated": "#152A40",
      "onNavy": "#E8F1FA"
    },
    "status": {
      "warning": "#F5A623",
      "danger": "#E74C3C",
      "success": "#2ECC71",
      "info": "#1565C0"
    },
    "pastel": {
      "peach": "#FFE3D5",
      "mint": "#D6F5E3",
      "lavender": "#E6DFF6",
      "sky": "#DCEEFB"
    },
    "surface": {
      "base": "#FFFFFF",
      "muted": "#F7F9FC",
      "border": "#EDF1F7",
      "overlay": "rgba(13,27,42,0.55)"
    },
    "text": {
      "primary": "#0D1B2A",
      "secondary": "#5A6B7F",
      "tertiary": "#8A99AB",
      "inverse": "#FFFFFF"
    }
  },
  "gradient": {
    "brand": {
      "angle": 135,
      "stops": [
        "#1565C0",
        "#2ECC71"
      ]
    },
    "primaryCta": {
      "angle": 135,
      "stops": [
        "#1565C0",
        "#1E5BB8"
      ]
    },
    "aiHalo": {
      "angle": 135,
      "stops": [
        "#1E5BB8",
        "#2ECC71"
      ]
    },
    "scannerVeil": {
      "angle": 180,
      "stops": [
        "rgba(13,27,42,0)",
        "#0D1B2A"
      ]
    }
  },
  "elevation": {
    "xs": {
      "shadowColor": "#0F2850",
      "shadowOpacity": 0.08,
      "shadowRadius": 2,
      "shadowOffsetY": 1,
      "androidElevation": 1
    },
    "sm": {
      "shadowColor": "#0F2850",
      "shadowOpacity": 0.08,
      "shadowRadius": 6,
      "shadowOffsetY": 2,
      "androidElevation": 2
    },
    "md": {
      "shadowColor": "#0F2850",
      "shadowOpacity": 0.1,
      "shadowRadius": 14,
      "shadowOffsetY": 6,
      "androidElevation": 6
    },
    "lg": {
      "shadowColor": "#0F2850",
      "shadowOpacity": 0.14,
      "shadowRadius": 24,
      "shadowOffsetY": 12,
      "androidElevation": 12
    }
  },
  "radius": {
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "base": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },
  "typography": {
    "family": {
      "heading": "Poppins",
      "body": "Inter",
      "numeric": "InterTabular"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "scale": {
      "display": {
        "size": 32,
        "lineHeight": 44,
        "weight": "700",
        "family": "heading"
      },
      "h1": {
        "size": 24,
        "lineHeight": 34,
        "weight": "700",
        "family": "heading"
      },
      "h2": {
        "size": 20,
        "lineHeight": 28,
        "weight": "600",
        "family": "heading"
      },
      "body": {
        "size": 15,
        "lineHeight": 23,
        "weight": "400",
        "family": "body"
      },
      "bodyStrong": {
        "size": 15,
        "lineHeight": 23,
        "weight": "600",
        "family": "body"
      },
      "caption": {
        "size": 12,
        "lineHeight": 18,
        "weight": "500",
        "family": "body"
      },
      "numeric": {
        "size": 24,
        "lineHeight": 32,
        "weight": "600",
        "family": "numeric"
      }
    }
  },
  "component": {
    "button": {
      "height": 48,
      "radius": 12,
      "pressScale": 0.97
    },
    "input": {
      "height": 56,
      "radius": 12,
      "focusRingWidth": 3
    },
    "card": {
      "radius": 18,
      "padding": 16,
      "borderWidth": 1
    },
    "badge": {
      "radius": 999,
      "paddingX": 10,
      "paddingY": 4
    },
    "iconTile": {
      "size": 44,
      "radius": 14,
      "iconSize": 24
    },
    "bottomNav": {
      "height": 68,
      "radius": 24,
      "fabSize": 60
    }
  },
  "motion": {
    "duration": {
      "instant": 120,
      "fast": 200,
      "base": 300,
      "screen": 350,
      "slow": 600,
      "count": 800,
      "loop": 1500
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)",
      "accelerate": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": {
        "damping": 14,
        "stiffness": 180,
        "mass": 1
      }
    },
    "stagger": {
      "chips": 60,
      "list": 40,
      "tagline": 100
    }
  }
}
